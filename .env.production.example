# FlowTech Hub — production environment (hub.flowtechapps.com)
# Copy to `.env.production` on the server and fill in the real secret values.
# NEVER commit the filled-in file.

NODE_ENV=production
# The BFF serves the built SPA on one origin (required by the strict cookie).
SERVE_WEB=true
WEB_DIST=/repo/apps/web/dist
# Port the container listens on (Caddy proxies to it). PORT also honoured.
API_PORT=4000
# Persist sessions + token cache to a mounted volume so redeploys don't log out.
DATA_DIR=/data

# --- Public URLs (all must be the https subdomain) -------------------------
WEB_ORIGIN=https://hub.flowtechapps.com
REDIRECT_URI=https://hub.flowtechapps.com/auth/redirect
POST_LOGOUT_REDIRECT_URI=https://hub.flowtechapps.com
# A long random string — sign/identify sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- Microsoft Entra (Azure AD) app registration ---------------------------
AZURE_TENANT_ID=b48e5923-385b-4b2e-b871-b9fbfc51bbe0
AZURE_CLIENT_ID=0faed498-3c8a-45de-81e8-c125ceabaf25
AZURE_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET
GRAPH_SCOPES=User.Read User.Read.All Calendars.ReadWrite Sites.ReadWrite.All Directory.Read.All offline_access openid profile email

# --- Company calendar (optional) --------------------------------------------
# Shared M365 calendar for admin-posted company events. Leave blank to keep
# those events in-memory instead (resets on redeploy). See SETUP.md.
COMPANY_CALENDAR_MAILBOX=

# --- Access control ----------------------------------------------------------
ADMIN_EMAILS=abk@flowtechapps.com,pr@flowtechapps.com,info@flowtechapps.com
ALLOWED_EMAIL_DOMAINS=flowtechapps.com
ADMIN_GROUP_ID=

# --- SharePoint document libraries (pinned by name) -------------------------
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_LIBRARY_NAME=Documents

# --- Dataverse ---------------------------------------------------------------
# Same environment as dev by design — production and local dev share this
# Dataverse instance and every table below, so there's only one set of tables
# to maintain. (Be mindful: local testing writes real data here too.)
DATAVERSE_URL=https://org4a45ea8d.crm.dynamics.com
DATAVERSE_SCOPE=https://org4a45ea8d.crm.dynamics.com/.default

