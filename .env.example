# =============================================================================
# FlowTech Hub — environment template
# Copy to `.env` (root) and fill in real values. NEVER commit the real .env.
# Every value below is consumed ONLY by the BFF (apps/api). The React bundle
# never receives secrets, tokens, or flow URLs.
# =============================================================================

# ---- App / server ----------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# 32+ char random string used to sign the session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Single-origin deployment: when true, the BFF also serves the built SPA so the
# app, /api and /auth share one origin (the strict session cookie needs this).
# Defaults to true in production. WEB_DIST points at apps/web/dist.
# SERVE_WEB=true
# WEB_DIST=

# ---- Microsoft Entra ID (Azure AD) app registration -----------------------
# From: Entra portal > App registrations > your app > Overview
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# BFF confidential-client secret (Certificates & secrets). SERVER-SIDE ONLY.
AZURE_CLIENT_SECRET=your-client-secret
# Redirect URI registered for the BFF web platform (must match the portal value)
REDIRECT_URI=http://localhost:4000/auth/redirect
# NOTE: Pure BFF topology — no exposed API scope / SPA redirect is required.
# (API_SCOPE only applies to the msal-react + OBO alternative, which is unused.)
POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# ---- Microsoft Graph -------------------------------------------------------
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# Delegated scopes requested via On-Behalf-Of (space separated)
GRAPH_SCOPES=User.Read User.ReadBasic.All Calendars.Read Files.ReadWrite.All offline_access openid profile email

# ---- SharePoint (Document center) -----------------------------------------
# Code resolves site + drive IDs by name via Graph and caches them.
# Provide the site host + path; TODO: fill from your tenant.
SHAREPOINT_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/FlowTechHub
SHAREPOINT_LIBRARY_NAME=Documents

# ---- Company calendar (shared calendar shown alongside personal events) ----
# A room/shared mailbox UPN or user object id. Leave empty for personal-only.
# Requires Calendars.Read (delegated) and that the user can read this calendar.
COMPANY_CALENDAR_MAILBOX=

# ---- Dataverse (structured data: announcements, requests, assets) ----------
# TODO: fill from your environment URL
DATAVERSE_URL=https://yourorg.crm.dynamics.com
DATAVERSE_SCOPE=https://yourorg.crm.dynamics.com/.default

# ---- Power Automate (HTTP-triggered flows) — SERVER-SIDE ONLY -------------
# TODO: paste the trigger POST URLs from your two flows.
FLOW_NOTIFY_URL=
FLOW_APPROVAL_URL=
# Vault flow: saves the credential to Dataverse and notifies all employees for
# shared (open) entries. See SETUP.md.
FLOW_VAULT_URL=
# Shared secret the approval flow sends back to /flows/approval-callback so the
# BFF can trust the outcome. Generate a long random string; set the same value
# in the flow's callback action header (x-flow-secret).
FLOW_CALLBACK_SECRET=change-me-to-a-long-random-string

# ---- Role gating -----------------------------------------------------------
# Entra security group object ID that grants access to the Admin panel.
ADMIN_GROUP_ID=00000000-0000-0000-0000-000000000000
